@@ -0,0 +1,62 @@
+import { describe, expect, it, vi } from 'vitest'
+import { fetchForkMacReleases, parseForkMacReleases } from './updater-fork-release-feed'
+
+const fetch = vi.hoisted(() => vi.fn())
+vi.mock('electron', () => ({ app: {}, net: { fetch } }))
+
+const installed = '1.4.275-local.forkpreview.102.abcdef123456'
+const timestamp = '2026-11-25T00:00:00.000Z'
+
+function release(tag: string, version: string, { manifest = true, draft = false } = {}) {
+  return {
+    tag_name: tag,
+    draft,
+    prerelease: true,
+    published_at: timestamp,
+    assets: [`Orca-${version}-arm64-mac.zip`, ...(manifest ? ['latest-mac.yml'] : [])].map(
+      (name) => ({
+        name,
+        state: 'uploaded',
+        browser_download_url: `https://github.com/gentslava/orca/releases/download/${tag}/${name}`
+      })
+    )
+  }
+}
+
+describe('fork macOS update feed', () => {
+  it('selects only published newer fork releases with a manifest and matching ARM64 ZIP', () => {
+    const newer = '1.4.275-local.forkpreview.103.abcdef123456'
+    const newest = '1.4.276-local.forkpreview.104.abcdef123456'
+    const foreign = release('personal-1235-1', newest)
+    foreign.assets[0].browser_download_url = foreign.assets[0].browser_download_url.replace(
+      'gentslava',
+      'stablyai'
+    )
+    expect(
+      parseForkMacReleases(
+        [
+          release('personal-1233-1', installed),
+          release('personal-1234-1', newest, { manifest: false }),
+          foreign,
+          release('personal-1236-1', newest, { draft: true }),
+          release('v1.4.276', newest),
+          release('personal-1237-1', newer),
+          release('personal-1238-1', newest)
+        ],
+        installed
+      )
+    ).toEqual([
+      { tag: 'personal-1238-1', version: newest, releasedAt: Date.parse(timestamp) },
+      { tag: 'personal-1237-1', version: newer, releasedAt: Date.parse(timestamp) }
+    ])
+  })
+
+  it('uses the fork only and handles GitHub failures without falling back to upstream', async () => {
+    fetch.mockResolvedValueOnce({ ok: false, status: 503 })
+    await expect(fetchForkMacReleases(installed)).rejects.toThrow('HTTP 503')
+    expect(fetch).toHaveBeenCalledExactlyOnceWith(
+      'https://api.github.com/repos/gentslava/orca/releases?per_page=100',
+      expect.objectContaining({ redirect: 'error' })
+    )
+  })
+})
diff --git a/src/main/updater/releases/updater-fork-release-feed.ts b/src/main/updater/releases/updater-fork-release-feed.ts
new file mode 100644
index 00000000000..4a9c7f18241
--- /dev/null
+++ b/src/main/updater/releases/updater-fork-release-feed.ts
@@ -0,0 +1,116 @@
+import { existsSync } from 'node:fs'
+import { join } from 'node:path'
+import { app, net } from 'electron'
+import { compareVersions, isValidVersion } from './updater-fallback'
+import { FETCH_TIMEOUT_MS } from './updater-release-readiness'
+import type { DatedReleaseTag } from './updater-release-delay'
+
+const releasesUrl = 'https://github.com/gentslava/orca/releases'
+const forkVersionSuffix = /[.-]local\.forkpreview\.\d+\.[0-9a-f]{1,12}$/
+const tagPattern = /^personal-[1-9]\d*-[1-9]\d*$/
+const zipPattern = /^Orca-(.+)-arm64-mac\.zip$/
+
+export function isPersonalForkBuild(): boolean {
+  return forkVersionSuffix.test(app.getVersion())
+}
+
+export function isForkMacBuild(): boolean {
+  return (
+    app.isPackaged &&
+    process.platform === 'darwin' &&
+    process.arch === 'arm64' &&
+    isPersonalForkBuild()
+  )
+}
+
+export function isForkMacUpdateBuild(): boolean {
+  return (
+    isForkMacBuild() &&
+    typeof process.resourcesPath === 'string' &&
+    existsSync(join(process.resourcesPath, 'orca-fork-macos-update-channel'))
+  )
+}
+
+export function forkReleasePage(tag: string): string {
+  return `${releasesUrl}/tag/${tag}`
+}
+
+export function forkReleaseDownloadUrl(tag: string): string {
+  return `${releasesUrl}/download/${tag}`
+}
+
+function isObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null
+}
+
+export const forkMacDmg = 'orca-macos-arm64.dmg'
+
+export function parseForkMacReleases(
+  data: unknown,
+  currentVersion: string,
+  requireSigned = true
+): DatedReleaseTag[] {
+  if (!Array.isArray(data)) {
+    throw new Error('Invalid GitHub fork release list')
+  }
+  const updates: DatedReleaseTag[] = []
+  for (const entry of data) {
+    if (
+      !isObject(entry) ||
+      entry.draft !== false ||
+      typeof entry.tag_name !== 'string' ||
+      !tagPattern.test(entry.tag_name) ||
+      typeof entry.published_at !== 'string' ||
+      !Array.isArray(entry.assets)
+    ) {
+      continue
+    }
+    const tag = entry.tag_name
+    const releasedAt = Date.parse(entry.published_at)
+    const assetBase = forkReleaseDownloadUrl(tag)
+    const assets = entry.assets.flatMap((asset: unknown) => {
+      if (
+        !isObject(asset) ||
+        typeof asset.name !== 'string' ||
+        asset.state !== 'uploaded' ||
+        asset.browser_download_url !== `${assetBase}/${asset.name}`
+      ) {
+        return []
+      }
+      return [asset.name]
+    })
+    const versions = assets.flatMap((name) => {
+      const version = zipPattern.exec(name)?.[1]
+      return version && forkVersionSuffix.test(version) && isValidVersion(version) ? [version] : []
+    })
+    if (
+      !Number.isFinite(releasedAt) ||
+      !assets.includes(requireSigned ? 'latest-mac.yml' : forkMacDmg) ||
+      (!requireSigned && !assets.includes('release-verification.json')) ||
+      versions.length !== 1 ||
+      compareVersions(versions[0], currentVersion) <= 0
+    ) {
+      continue
+    }
+    updates.push({ tag, version: versions[0], releasedAt })
+  }
+  return updates.sort((left, right) => compareVersions(right.version, left.version))
+}
+
+export async function fetchForkMacReleases(
+  currentVersion: string,
+  requireSigned = true
+): Promise<DatedReleaseTag[]> {
+  const response = await net.fetch(
+    'https://api.github.com/repos/gentslava/orca/releases?per_page=100',
+    {
+      headers: { Accept: 'application/vnd.github+json' },
+      redirect: 'error',
+      signal: AbortSignal.timeout(FETCH_TIMEOUT_MS)
+    }
+  )
+  if (!response.ok) {
+    throw new Error(`Fork release list returned HTTP ${response.status}`)
+  }
+  return parseForkMacReleases(await response.json(), currentVersion, requireSigned)
+}
