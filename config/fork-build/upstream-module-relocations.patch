+  ).toEqual([
+    [JSON.stringify(['ungrouped', true]), ['local']],
+    [JSON.stringify(['ungrouped', false]), ['remote']],
+    ['group:other', ['other-group']]
+  ])
+  expect([...buckets.values()]).toEqual([['same'], ['same'], ['same']])
+})
