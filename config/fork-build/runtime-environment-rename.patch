@@ -0,0 +1,65 @@
+import { mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterEach, expect, it, vi } from 'vitest'
+import { main } from '../index'
+import { encodePairingOffer } from '../../shared/remote-runtime/pairing/pairing'
+import {
+  addEnvironmentFromPairingCode,
+  resolveEnvironment
+} from '../../shared/remote-runtime/host-store/runtime-environment-store'
+import { getEnvironmentStorePath } from '../../shared/remote-runtime/host-store/runtime-environment-store-records'
+
+const directories: string[] = []
+const originalExitCode = process.exitCode
+
+afterEach(() => {
+  vi.unstubAllEnvs()
+  vi.restoreAllMocks()
+  process.exitCode = originalExitCode
+  for (const directory of directories.splice(0)) {
+    rmSync(directory, { recursive: true, force: true })
+  }
+})
+
+it('renames the selected saved server offline without changing pairing or unreadable entries', async () => {
+  const directory = mkdtempSync(join(tmpdir(), 'orca-environment-rename-'))
+  directories.push(directory)
+  vi.stubEnv('ORCA_USER_DATA_PATH', directory)
+  vi.stubEnv('ORCA_ENVIRONMENT', 'stale-selection')
+  const existing = addEnvironmentFromPairingCode(directory, {
+    name: 'Old server',
+    pairingCode: encodePairingOffer({
+      v: 2,
+      endpoint: 'ws://127.0.0.1:6768',
+      deviceToken: 'private-pairing-token',
+      publicKeyB64: Buffer.from(new Uint8Array(32).fill(1)).toString('base64')
+    })
+  })
+  const path = getEnvironmentStorePath(directory)
+  const store = JSON.parse(readFileSync(path, 'utf8'))
+  const unreadable = { id: 'newer-server', name: 'Future server', futureVersion: 2 }
+  store.environments.push(unreadable)
+  writeFileSync(path, JSON.stringify(store))
+  const log = vi.spyOn(console, 'log').mockImplementation(() => {})
+
+  await main(
+    ['environment', 'rename', '--environment', existing.id, '--name', 'New server', '--json'],
+    directory
+  )
+
+  expect(process.exitCode ?? 0).toBe(0)
+  expect(resolveEnvironment(directory, existing.id)).toEqual({
+    ...existing,
+    name: 'New server',
+    updatedAt: expect.any(Number)
+  })
+  expect(JSON.parse(readFileSync(path, 'utf8')).environments).toContainEqual(unreadable)
+  const output = String(log.mock.calls[0]?.[0])
+  expect(JSON.parse(output)).toMatchObject({
+    ok: true,
+    result: { environment: { id: existing.id, name: 'New server' } }
+  })
+  expect(output).not.toContain('private-pairing-token')
+  expect(output).not.toContain('publicKeyB64')
+})
