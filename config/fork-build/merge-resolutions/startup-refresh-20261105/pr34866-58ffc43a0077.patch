+// @vitest-environment happy-dom
+import { act, cleanup, waitFor } from '@testing-library/react'
+import { afterEach, expect, it } from 'vitest'
+import type { AgentSessionModelCatalogResult } from '../../../../shared/agent-session/agent-session-wire'
+import { resetHostModelCatalogSnapshotsForTests } from '@/runtime/host-model-catalog-snapshots'
+import { forgetStructuredSessionSelection } from '@/lib/structured-agent-session-selection-controller'
+import {
+  mocks,
+  answer,
+  mutateWith,
+  REOPENED,
+  renderOptions
+} from './use-structured-agent-session-options.test-fixture'
+
+afterEach(() => {
+  cleanup()
+  mocks.coherentCatalog = false
+  forgetStructuredSessionSelection('session-1')
+  resetHostModelCatalogSnapshotsForTests()
+})
+
+it('keeps a saved effort read-only when a quiet refresh removes it from supported choices', async () => {
+  mocks.call.mockReset()
+  mocks.supportsRemote.mockResolvedValue(false)
+  mocks.coherentCatalog = true
+  resetHostModelCatalogSnapshotsForTests()
+  const efforts = [
+    { value: 'low', label: 'Low' },
+    { value: 'high', label: 'High' }
+  ]
+  const models = [{ id: 'A', label: 'Installed A', isDefault: true, efforts }]
+  let raw: Exclude<AgentSessionModelCatalogResult, { origin: 'unknown' }> = {
+    origin: 'probe',
+    fetchedAt: 1000,
+    models
+  }
+  const next = Promise.withResolvers<AgentSessionModelCatalogResult>()
+  answer({
+    options: async () => ({
+      models,
+      current: { model: 'A', effort: 'low', permissionMode: 'ask', defaulted: [] }
+    }),
+    modelCatalog: async () => {
+      const request = mocks.call.mock.calls.findLast(
+        ([, method]) => method === 'agentSession.modelCatalog'
+      )
+      return request?.[2]?.waitForListing ? next.promise : raw
+    }
+  })
+  const view = renderOptions(REOPENED, mutateWith(async () => null).mutate)
+  const effort = () => view.result.current.optionSnapshot.find((row) => row.id === 'effort')
+  await waitFor(() => expect(effort()?.settable).toBe(true))
+  raw = { ...raw, listingInProgress: true }
+  await act(async () => view.result.current.optionSurface.demandModelCatalog?.())
+  expect(effort()?.settable).toBe(true)
+  expect(view.result.current.sendSource.optionStateRef.current.listingInProgress).toBe(true)
+  await act(async () =>
+    next.resolve({
+      ...raw,
+      listingInProgress: undefined,
+      models: raw.models.map((row) => ({ ...row, efforts: [efforts[1]!] }))
+    })
+  )
+  await waitFor(() =>
+    expect(effort()).toMatchObject({
+      settable: false,
+      kind: { currentValue: 'low', choices: [{ value: 'low', label: 'low' }] }
+    })
+  )
+  expect(view.result.current.sendSource.optionStateRef.current.record.values).toMatchObject({
+    model: { value: 'A' },
+    effort: { value: 'low' }
+  })
+  view.unmount()
+})
