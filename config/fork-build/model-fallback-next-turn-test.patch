+// @vitest-environment happy-dom
+
+import { act, cleanup, fireEvent, render, screen, waitFor } from '@testing-library/react'
+import { afterEach, expect, it, vi } from 'vitest'
+
+const rpc = vi.hoisted(() => ({ call: vi.fn() }))
+vi.mock('@/runtime/native-chat/requests/structured-agent-session-call', () => ({
+  callStructuredAgentSession: rpc.call
+}))
+vi.mock('@/runtime/native-chat/requests/structured-agent-session-subscriptions', () => ({
+  subscribeStructuredAgentSessionStatus: async () => ({ unsubscribe: () => {} })
+}))
+vi.mock('@/runtime/native-chat/host-capabilities/structured-agent-session-host-capability', () => ({
+  useStructuredAgentSessionHostCapability: () => true,
+  useStructuredAgentSessionOwnPermissionState: () => 'supported',
+  useStructuredAgentSessionHostCapabilityState: () => 'unknown',
+  structuredAgentSessionHostKey: () => 'local'
+}))
+vi.mock('./session/options/native-chat-session-option-settings-write', () => ({
+  enqueueSessionOptionSettingsWrite: () => Promise.resolve()
+}))
+vi.mock('@/i18n/i18n', () => ({
+  translate: (_key: string, fallback: string, values?: Record<string, string | number>) =>
+    Object.entries(values ?? {}).reduce(
+      (text, [key, value]) => text.replaceAll(`{{${key}}}`, String(value)),
+      fallback
+    )
+}))
+
+import { TooltipProvider } from '@/components/ui/tooltip'
+import { NativeChatSessionOptionPickers } from './session/options/controls/NativeChatSessionOptionPickers'
+import { useStructuredAgentSessionOptions } from './session/options/structured/use-structured-agent-session-options'
+import { useStructuredAgentSessionSendOptions } from './session/structured/delivery/use-structured-agent-session-send-options'
+import { forgetStructuredSessionSelection } from '@/lib/agent-session/options/structured-agent-session-selection-controller'
+
+const target = { kind: 'local' } as const
+const sessionId = 'mid-turn-picker'
+afterEach(() => {
+  cleanup()
+  forgetStructuredSessionSelection(sessionId)
+})
+
+it('keeps the next-turn model and captured input stable when host execution reports change', async () => {
+  let reportedModel = 'claude-opus-5-5'
+  const sent: unknown[] = []
+  const reports: string[] = []
+  rpc.call.mockImplementation(async (_target, method) => {
+    if (method === 'agentSession.options') {
+      reports.push(reportedModel)
+      return {
+        models: [{ id: 'claude-opus-5-5', label: 'Opus 5.5', efforts: [] }],
+        current: {
+          model: 'claude-opus-5-5',
+          reportedModel,
+          defaulted: [],
+          acceptedInputSources: { model: 'saved' }
+        }
+      }
+    }
+    if (method === 'agentSession.modelCatalog') {
+      return { origin: 'unknown' }
+    }
+    throw new Error(`Unexpected RPC ${method}`)
+  })
+  function Composer({ stamp }: { stamp: string }) {
+    const options = useStructuredAgentSessionOptions({
+      agent: 'claude',
+      sessionId,
+      target,
+      fence: 1,
+      transportEnabled: true,
+      isVisible: true,
+      providerVisible: true,
+      providerRunning: true,
+      turnId: 'running',
+      unloadedTurnRevisions: undefined,
+      hostOptionStamp: stamp,
+      mutate: async () => null
+    })
+    const capture = useStructuredAgentSessionSendOptions(sessionId, undefined, options.sendSource)
+    return (
+      <TooltipProvider>
+        <NativeChatSessionOptionPickers
+          surface={options.optionSurface}
+          snapshot={options.optionSnapshot}
+          isWorking={true}
+        />
+        <button onClick={() => sent.push(capture())}>Capture next message</button>
+      </TooltipProvider>
+    )
+  }
+  const { rerender } = render(<Composer stamp={reportedModel} />)
+  await waitFor(() =>
+    expect(
+      screen.getByRole('button', { name: /^Next turn: Model (Claude )?Opus 5\.5$/ })
+    ).toBeTruthy()
+  )
+  reportedModel = 'claude-opus-4-8'
+  await act(async () => rerender(<Composer stamp={reportedModel} />))
+  expect(reports.at(-1)).toBe(reportedModel)
+  await waitFor(() =>
+    expect(
+      screen.getByRole('button', { name: /^Next turn: Model (Claude )?Opus 5\.5$/ })
+    ).toBeTruthy()
+  )
+  fireEvent.click(screen.getByText('Capture next message'))
+  expect(sent).toEqual([{ selection: { model: 'claude-opus-5-5' } }])
+  reportedModel = 'claude-opus-5-5'
+  await act(async () => rerender(<Composer stamp={reportedModel} />))
+  expect(reports.at(-1)).toBe(reportedModel)
+  await waitFor(() =>
+    expect(
+      screen.getByRole('button', { name: /^Next turn: Model (Claude )?Opus 5\.5$/ })
+    ).toBeTruthy()
+  )
+})
